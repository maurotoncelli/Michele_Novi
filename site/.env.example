# Copia in .env.local. Nessuna di queste è obbligatoria per il build.

# URL pubblico (usato finché settings.dominio è vuoto)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keystatic: "local" (default, scrive su content/) oppure "github"
KEYSTATIC_STORAGE=local
# Solo con KEYSTATIC_STORAGE=github (GitHub App: https://keystatic.com/docs/github-mode)
KEYSTATIC_GITHUB_OWNER=maurotoncelli
KEYSTATIC_GITHUB_REPO=Michele_Novi
# Sottocartella del repo in cui sta il sito (il repo contiene anche bibbia/)
KEYSTATIC_PATH_PREFIX=site
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=

# Form contatti → email (Resend). Senza chiave il form logga e risponde ok.
RESEND_API_KEY=
RESEND_FROM="Sito Michele Novi <sito@michelenovi.it>"

# GA4: se assente, niente banner e niente analytics
NEXT_PUBLIC_GA_ID=
